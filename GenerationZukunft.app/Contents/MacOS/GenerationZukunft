#!/bin/bash
# Native macOS App Launcher für Generation Zukunft
APP_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$APP_DIR" || exit 1

if [ -d "macos/Runner.xcodeproj" ]; then
    open macos/Runner.xcodeproj
    exit 0
fi

if command -v flutter &> /dev/null; then
    flutter run -d macos
    exit 0
fi

npm run dev &
sleep 2
open "http://localhost:3000"
